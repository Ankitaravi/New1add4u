# Copy to .env. NODE_ENV=production makes the API refuse to start without the Razorpay values.
NODE_ENV=production
POSTGRES_PASSWORD=change-me
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8080

# Razorpay (Dashboard > API Keys, and Webhooks with event "payment.captured"
# pointing at <api>/payments/webhook)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional. Without these, pushes / AI endpoints are disabled (not broken).
FIREBASE_SERVICE_ACCOUNT=   # service-account JSON on one line
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_HOURLY_LIMIT=20
